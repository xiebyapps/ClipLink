import { fileIo as fs, fileUri, picker } from '@kit.CoreFileKit';
import { common } from '@kit.AbilityKit';
import { ConfigService } from './ConfigService';
import { AppConfig, DownloadRule } from '../types/ApiTypes';
import { SettingsPolicy } from '../utils/SettingsPolicy';

class MoveJournal {
  source: string = '';
  target: string = '';
}

class OrganizationIndex {
  sequence: number = 0;
  directories: string[] = [];
  legacyChecked: boolean = false;
  pending: boolean = true;
  move?: MoveJournal;
  staging: string[] = [];
}

export class DownloadPlacement {
  path: string = '';
  folder: string = '';
  name: string = '';
}

/** Only registered classification directories are reorganized. Public exports are never cache entries. */
export class DownloadOrganizationService {
  private static instance: DownloadOrganizationService = new DownloadOrganizationService();
  private queue: Promise<void> = Promise.resolve();
  private index: OrganizationIndex = new OrganizationIndex();
  private indexRoot: string = '';
  private root: string = '';
  private initialized: boolean = false;

  static getInstance(): DownloadOrganizationService { return DownloadOrganizationService.instance; }

  private async initialize(owner?: common.UIAbilityContext): Promise<void> {
    if (this.initialized) return;
    const context = owner || AppStorage.get<common.UIAbilityContext>('abilityContext');
    if (!context) throw new Error('Ability context is not initialized');
    this.indexRoot = `${context.filesDir}/download-organization`;
    if (!fs.accessSync(this.indexRoot)) fs.mkdirSync(this.indexRoot);
    for (let slot = 0; slot < 2; slot++) {
      try {
        const value = JSON.parse(fs.readTextSync(`${this.indexRoot}/index-${slot}.json`)) as OrganizationIndex;
        if (Array.isArray(value.directories) && Array.isArray(value.staging) && value.sequence > this.index.sequence) {
          this.index = value;
        }
      } catch (_) { }
    }
    const options = new picker.DocumentSaveOptions();
    options.pickerMode = picker.DocumentPickerMode.DOWNLOAD;
    const uris = await new picker.DocumentViewPicker(context).save(options);
    if (!uris?.length) throw new Error('Download directory is unavailable');
    this.root = new fileUri.FileUri(uris[0]).path.replace(/\/$/, '');
    this.index.directories = this.index.directories.filter((path: string): boolean =>
      this.validDirectory(path));
    // Staging names are generated by this service, never inferred from arbitrary public files.
    for (const name of this.index.staging) {
      if (/^\.cliplink-[a-z0-9-]+\.part$/.test(name) && fs.accessSync(`${this.root}/${name}`)) fs.unlinkSync(`${this.root}/${name}`);
    }
    this.index.staging = [];
    if (!this.index.legacyChecked) {
      for (const folder of ['Sounds', 'Documents', 'Other']) {
        const relative = `云剪/${folder}`;
        if (fs.accessSync(`${this.root}/${relative}`) && fs.lstatSync(`${this.root}/${relative}`).isDirectory()) {
          if (!this.index.directories.includes(relative)) this.index.directories.push(relative);
        }
      }
      this.index.legacyChecked = true;
    }
    this.initialized = true;
    this.persist();
  }

  private validDirectory(path: string): boolean {
    return SettingsPolicy.folderIsValid(path) || /^云剪\/(Sounds|Documents|Other)$/.test(path);
  }

  private safeRelativeFile(path: string): boolean {
    const parts = path.split('/');
    return parts.length <= 3 && parts.every((part: string): boolean =>
      !!part && part !== '.' && part !== '..' && !/[\\\x00-\x1f]/.test(part)) &&
      (parts.length === 1 || this.index.directories.includes(parts.slice(0, -1).join('/')) ||
        (parts.length === 2 && parts[0] === '云剪'));
  }

  private persist(): void {
    this.index.sequence++;
    const slot = this.index.sequence % 2;
    const temporary = `${this.indexRoot}/index-${slot}.part`;
    const target = `${this.indexRoot}/index-${slot}.json`;
    const file = fs.openSync(temporary, fs.OpenMode.CREATE | fs.OpenMode.READ_WRITE | fs.OpenMode.TRUNC);
    try { fs.writeSync(file.fd, JSON.stringify(this.index), { encoding: 'utf-8' }); }
    finally { fs.closeSync(file); }
    if (fs.accessSync(target)) fs.unlinkSync(target);
    fs.renameSync(temporary, target);
  }

  private enqueue(work: () => Promise<void>): Promise<void> {
    const operation = this.queue.then(work);
    this.queue = operation.catch((): void => {});
    return operation;
  }

  private assertFolder(folder: string): void {
    if (!SettingsPolicy.folderIsValid(folder) || folder === '云剪') throw new Error('Enter a valid folder name');
    const path = `${this.root}/${folder}`;
    if (fs.accessSync(path) && (!this.index.directories.includes(folder) || !fs.lstatSync(path).isDirectory())) {
      throw new Error('This folder already exists and is not managed by classification');
    }
  }

  private ensureFolder(folder: string): string {
    this.assertFolder(folder);
    if (!this.index.directories.includes(folder)) {
      this.index.directories.push(folder);
      this.persist();
    }
    const path = `${this.root}/${folder}`;
    if (!fs.accessSync(path)) fs.mkdirSync(path);
    return path;
  }

  private unique(directory: string, name: string): string {
    const dot = name.lastIndexOf('.');
    const base = dot > 0 ? name.slice(0, dot) : name;
    const suffix = dot > 0 ? name.slice(dot) : '';
    for (let i = 0; i < 10000; i++) {
      const candidate = `${directory}/${i === 0 ? name : `${base} (${i})${suffix}`}`;
      if (!fs.accessSync(candidate)) return candidate;
    }
    throw new Error('Too many files with the same name');
  }

  private async recoverMove(): Promise<void> {
    const move = this.index.move;
    if (!move) return;
    if (!this.safeRelativeFile(move.source) || !this.safeRelativeFile(move.target)) throw new Error('Invalid organization journal');
    const source = `${this.root}/${move.source}`;
    const target = `${this.root}/${move.target}`;
    if (fs.accessSync(source)) {
      if (!fs.lstatSync(source).isFile()) throw new Error('Invalid organization journal');
      if (fs.accessSync(target)) {
        move.target = this.unique(target.slice(0, target.lastIndexOf('/')), source.split('/').pop() || 'File.bin').slice(this.root.length + 1);
        this.persist();
      }
      // Mode 1 rejects collisions rather than overwriting an existing file.
      await fs.moveFile(source, `${this.root}/${move.target}`, 1);
    }
    this.index.move = undefined;
    this.persist();
  }

  private async organize(): Promise<void> {
    await this.recoverMove();
    const config = ConfigService.getInstance().getConfig();
    const sources = ['', '云剪'].concat(this.index.directories);
    const seen = new Set<string>();
    const files: string[] = [];
    for (const relative of sources) {
      const directory = relative ? `${this.root}/${relative}` : this.root;
      if (!fs.accessSync(directory) || !fs.lstatSync(directory).isDirectory()) continue;
      for (const name of fs.listFileSync(directory)) {
        const source = relative ? `${relative}/${name}` : name;
        if (seen.has(source) || this.index.staging.includes(name)) continue;
        if (!fs.lstatSync(`${this.root}/${source}`).isFile()) continue;
        seen.add(source); files.push(source);
      }
    }
    for (const source of files) {
      const name = source.split('/').pop() || 'File.bin';
      const folder = config.classifyDownloads ? SettingsPolicy.folderFor(name, config.downloadRules) : '';
      const desired = folder ? `${folder}/${name}` : name;
      if (source === desired) continue;
      const directory = folder ? this.ensureFolder(folder) : this.root;
      this.index.move = { source: source, target: this.unique(directory, name).slice(this.root.length + 1) };
      this.persist();
      await this.recoverMove();
    }
    for (const relative of this.index.directories) {
      const path = `${this.root}/${relative}`;
      if (fs.accessSync(path) && fs.lstatSync(path).isDirectory() && fs.listFileSync(path).length === 0) fs.rmdirSync(path);
    }
    const legacy = `${this.root}/云剪`;
    if (fs.accessSync(legacy) && fs.lstatSync(legacy).isDirectory() && fs.listFileSync(legacy).length === 0) fs.rmdirSync(legacy);
    this.index.pending = false;
    this.persist();
    AppStorage.setOrCreate('downloadOrganizationError', '');
  }

  async resume(): Promise<void> {
    return this.enqueue(async (): Promise<void> => {
      await this.initialize();
      if (this.index.pending || this.index.move) await this.organize();
    }).catch((error: Error): void => {
      AppStorage.setOrCreate('downloadOrganizationError', error.message);
      console.error('[DownloadOrganization]', error.message);
    });
  }

  async configure(enabled: boolean, rules: DownloadRule[]): Promise<void> {
    const validated = SettingsPolicy.validateRules(rules);
    return this.enqueue(async (): Promise<void> => {
      await this.initialize();
      if (enabled) for (const folder of new Set<string>(validated.map((rule: DownloadRule): string => rule.folder).concat(['Other']))) {
        this.assertFolder(folder);
      }
      this.index.pending = true;
      this.persist();
      await ConfigService.getInstance().updateConfig((config: AppConfig): void => {
        config.classifyDownloads = enabled; config.downloadRules = validated;
      });
      try { await this.organize(); }
      catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        AppStorage.setOrCreate('downloadOrganizationError', message);
        throw new Error(`Classification saved, but organization failed: ${message}`);
      }
    });
  }

  async save(name: string, writer: (path: string) => Promise<void>, context?: common.UIAbilityContext): Promise<DownloadPlacement> {
    let result = new DownloadPlacement();
    await this.enqueue(async (): Promise<void> => {
      await this.initialize(context);
      if (this.index.pending) {
        try { await this.organize(); }
        catch (error) { AppStorage.setOrCreate('downloadOrganizationError', String(error)); }
      }
      const config = ConfigService.getInstance().getConfig();
      const folder = config.classifyDownloads ? SettingsPolicy.folderFor(name, config.downloadRules) : '';
      const directory = folder ? this.ensureFolder(folder) : this.root;
      const stage = `.cliplink-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}.part`;
      this.index.staging.push(stage); this.persist();
      try {
        await writer(`${this.root}/${stage}`);
        const target = this.unique(directory, name);
        await fs.moveFile(`${this.root}/${stage}`, target, 1);
        result = { path: target, folder: folder, name: target.split('/').pop() || name };
      } finally {
        if (fs.accessSync(`${this.root}/${stage}`)) fs.unlinkSync(`${this.root}/${stage}`);
        this.index.staging = this.index.staging.filter((item: string): boolean => item !== stage);
        this.persist();
      }
    });
    return result;
  }
}
